+// @vitest-environment jsdom
+import { cleanup, render } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { ExperimentalNewThreadModelPickerProps } from "@get-bb/plugin-sdk";
+import {
+  ExecutionControls,
+  type ExecutionControlsProps,
+} from "./ExecutionControls";
+
+vi.mock("@/hooks/useThreadCreationOptions", () => ({
+  formatModelLabel: (value: string) => value,
+}));
+vi.mock("@/components/pickers/ModelReasoningPicker", () => ({
+  ModelReasoningPicker: () => <div>Native picker</div>,
+}));
+afterEach(() => {
+  cleanup();
+  vi.restoreAllMocks();
+});
+
+function controls(): ExecutionControlsProps {
+  return {
+    provider: {
+      selectedId: "codex",
+      options: [
+        { value: "codex", label: "Codex" },
+        { value: "claude", label: "Claude" },
+      ],
+      hasMultiple: true,
+      onChange: vi.fn(),
+    },
+    model: {
+      selected: "astra",
+      options: [
+        { value: "astra", label: "Astra" },
+        { value: "blocked", label: "Blocked", disabled: true },
+      ],
+      moreOptions: [],
+      isLoading: false,
+      loadFailed: false,
+      catalogIsVerified: true,
+      onChange: vi.fn(),
+    },
+    reasoning: {
+      value: "medium",
+      options: [
+        { value: "medium", label: "Medium" },
+        { value: "high", label: "High" },
+      ],
+      onChange: vi.fn(),
+    },
+    serviceTier: { supported: true, value: "default", onChange: vi.fn() },
+  };
+}
+
+describe("custom new-thread picker boundary", () => {
+  it("rejects unknown and disabled choices and blocks actions for unverified catalogs", () => {
+    const captured: ExperimentalNewThreadModelPickerProps[] = [];
+    const Custom = (props: ExperimentalNewThreadModelPickerProps) => {
+      captured.push(props);
+      return null;
+    };
+    const config = controls();
+    const view = render(<ExecutionControls {...config} modelPicker={Custom} />);
+    let actions = captured.at(-1)!;
+    actions.onModelChange("missing");
+    actions.onModelChange("blocked");
+    actions.onProviderChange("missing");
+    expect(config.model.onChange).not.toHaveBeenCalled();
+    expect(config.provider.onChange).not.toHaveBeenCalled();
+    actions.onModelChange("astra");
+    expect(config.model.onChange).toHaveBeenCalledExactlyOnceWith("astra");
+    view.rerender(
+      <ExecutionControls
+        {...config}
+        model={{ ...config.model, catalogIsVerified: false }}
+        modelPicker={Custom}
+      />,
+    );
+    actions = captured.at(-1)!;
+    actions.onModelChange("astra");
+    actions.onReasoningChange("high");
+    actions.onServiceTierChange("fast");
+    expect(config.model.onChange).toHaveBeenCalledTimes(1);
+    expect(config.reasoning.onChange).not.toHaveBeenCalled();
+    expect(config.serviceTier?.onChange).not.toHaveBeenCalled();
+  });
+  it("does not remount custom UI when switching providers and respects provider locks", () => {
+    const captured: ExperimentalNewThreadModelPickerProps[] = [];
+    const Custom = (props: ExperimentalNewThreadModelPickerProps) => {
+      captured.push(props);
+      return <input defaultValue="search" />;
+    };
+    const config = controls();
+    const view = render(<ExecutionControls {...config} modelPicker={Custom} />);
+    const input = view.getByRole("textbox");
+    view.rerender(
+      <ExecutionControls
+        {...config}
+        provider={{
+          ...config.provider,
+          selectedId: "claude",
+          onChange: undefined,
+        }}
+        modelPicker={Custom}
+      />,
+    );
+    expect(view.getByRole("textbox")).toBe(input);
+    captured.at(-1)!.onProviderChange("codex");
+    expect(config.provider.onChange).not.toHaveBeenCalled();
+  });
+  it("falls back to the native picker when the plugin renderer throws", () => {
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    function Broken(): never {
+      throw new Error("plugin failed");
+    }
+    const view = render(
+      <ExecutionControls {...controls()} modelPicker={Broken} />,
+    );
+    expect(view.getByText("Native picker")).toBeTruthy();
+  });
+});
